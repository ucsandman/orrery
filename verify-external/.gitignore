# Local environments and caches (never committed)
.venv/
node_modules/
__pycache__/
.pytest_cache/
*.log

# Run artifact: per-run measured maxima (the committed source of truth is bar-external.json)
generated/measured.json

# Break-push artifacts: per-round adversarial samples, overwritten each round and never
# committed (the committed fixtures are the nominal sample; the break run is reproducible
# from the seed and round offset in sample/emit.ts).
generated/*.adversarial.json
